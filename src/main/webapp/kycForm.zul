<?xml version="1.0" encoding="UTF-8"?>
<zk>
	<style src="/resources/css/bankingForms.css" />

	<window border="none" width="100%" sclass="kyc-page"
		viewModel="@id('vm') @init('com.fintrust.viewModel.UserProfileVM')">

		<vlayout width="100%" sclass="form-container">

			<!-- Header -->
			<vbox pack="center" align="center" hflex="1">
				<label value="Customer KYC Verification"
					sclass="form-title" />
				<label
					value="Please fill the KYC details correctly to activate your account."
					style="color:#666;margin-bottom:10px;" />
			</vbox>

			<separator />

			<!-- TWO COLUMN GRID -->
			<grid width="100%">
				<columns>
					<column width="50%" />
					<column width="50%" />
				</columns>

				<rows>

					<!-- NAME + PHONE -->
					<row>
						<vlayout>
							<label value="Full Name:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.user.fullName)"
								placeholder="As per ID proof" />
						</vlayout>

						<vlayout>
							<label value="Mobile Number:" />
							<longbox width="90%"
								value="@bind(vm.userDetails.user.phone)"
								placeholder="10-digit mobile" />
						</vlayout>
					</row>

					<!-- EMAIL + DOB -->
					<row>
						<vlayout>
							<label value="Email Address:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.user.email)"
								placeholder="example@mail.com" />
						</vlayout>

						<vlayout>
							<label value="Date of Birth:" />
							<datebox width="90%"
								value="@bind(vm.userDetails.dob)" />
						</vlayout>
					</row>

					<!-- GENDER + AADHAAR -->
					<row>
						<vlayout>
							<label value="Gender:" />
							<radiogroup
								selectedItem="@bind(vm.userDetails.gender)">
								<hbox spacing="10px">
									<radio label="Male" value="Male" />
									<radio label="Female"
										value="Female" />
									<radio label="Other" value="Other" />
								</hbox>
							</radiogroup>
						</vlayout>

						<vlayout>
							<label value="Aadhaar Number:" />
							<longbox width="90%"
								value="@bind(vm.userDetails.aadhaarMasked)"
								placeholder="12-digit Aadhaar" />
						</vlayout>
					</row>

					<!-- PAN + COUNTRY -->
					<row>
						<vlayout>
							<label value="PAN Number:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.panMasked)"
								placeholder="ABCDE1234F" />
						</vlayout>

						<vlayout>
							<label value="Country:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.country)" placeholder="Country" />
						</vlayout>
					</row>

					<!-- STATE + DISTRICT -->
					<row>
						<vlayout>
							<label value="State:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.state)" placeholder="State" />
						</vlayout>

						<vlayout>
							<label value="District:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.district)" placeholder="District" />
						</vlayout>
					</row>

					<!-- CITY + PINCODE -->
					<row>
						<vlayout>
							<label value="City:" />
							<textbox width="90%"
								value="@bind(vm.userDetails.city)" placeholder="City" />
						</vlayout>

						<vlayout>
							<label value="Pincode:" />
							<longbox width="90%"
								value="@bind(vm.userDetails.pincode)"
								placeholder="6-digit pincode" />
						</vlayout>
					</row>

					<!-- FILE UPLOADS -->
					<row>
						<vlayout>
							<label value="Address Proof:" />
							<fileupload label="Upload (PDF/JPG)"
								onUpload="@command('uploadAddressProof', file=event.media)" />
						</vlayout>

						<vlayout>
							<label value="Photo:" />
							<fileupload label="Upload Photo"
								onUpload="@command('uploadPhoto', file=event.media)" />
						</vlayout>
					</row>

				</rows>
			</grid>

			<separator />

			<!-- Submit Button -->
			<hbox pack="center" spacing="20px" hflex="1">
				<button label="Submit KYC"
					onClick="@command('submitKyc')" sclass="primary-btn" />
			</hbox>

		</vlayout>

	</window>

</zk>
