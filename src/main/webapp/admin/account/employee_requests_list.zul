<zk>

<style>
        .form-container {  
        	min-width: 40%;
        	max-width: 75%;
        	margin: 30px auto;
        	background: #fff;
        	padding: 25px;
        	border-radius: 15px;
        	box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

     	label {
            font-weight: bold;
            color: #333;
        }

       
        .btn-primary {
            background: linear-gradient(135deg, #6c63ff, #8e7dff);
            color: white;
            border: none;
            padding: 10px 0;
            border-radius: 10px;
            font-size: 12pt;
            cursor: pointer;
            transition: 0.3s all;
            width: 150px;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #574fd6, #6c63ff);
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

        </style>

<hbox align = "center" pack = "center" width="100%" height = "100%" style = " background-color: #003366;">
<window sclass="form-container" border="normal" apply="com.fintrust.admin.controller.EmployeeApprovalController">
    
     <hbox align="center" pack="center" spacing="10px" height="50px" width="100%">
	 	<label value="Pending Account Updation Requests" style="font-size:20px; font-weight:bold; color:#333" />
	 </hbox>
    <listbox id="requestList" width="100%" mold="paging" pageSize="10">
        <listhead>
            <listheader label="Request Id"/>
            <listheader label="Account No"/>
            <listheader label="New Type"/>
            <listheader label="New Branch"/>
            <listheader label="New Mode"/>
        </listhead>
        <template name="model">
            <listitem>
                <listcell label="${each.requestId}"/>
                <listcell label="${each.accountNo}"/>
                <listcell label="${each.newAccountType}"/>
                <listcell label="${each.newBranchName}"/>
                <listcell label="${each.newModeOfOperation}"/>
            </listitem>
        </template>
    </listbox>
    <hbox align="center" spacing="10px" style="margin-top:10px;">
        <button id="approveBtn" label="Approve" sclass="btn-primary"/>
        <button id="rejectBtn" label="Reject" sclass="btn-primary"/>
    </hbox>
</window>
</hbox>
</zk>