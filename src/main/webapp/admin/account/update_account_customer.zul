<zk>

<style>
        .form-container {  
        	min-width: 40%;
        	max-width: 90%;
        	margin: 30px auto;
        	background: #fff;
        	padding: 25px;
        	border-radius: 15px;
        	box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        	 animation: fadeIn 0.5s ease-in;
        }
        
         @keyframes fadeIn {
        0% {opacity: 0; transform: translateY(20px);}
        100% {opacity: 1; transform: translateY(0);}
    }

     	label {
            font-weight: bold;
            color: #333;
        }

       
        .btn-primary {
            background: linear-gradient(135deg, #6c63ff, #8e7dff);
            color: white;
            border: none;
            padding: 10px 0;
            border-radius: 10px;
            font-size: 12pt;
            cursor: pointer;
            transition: 0.3s all;
            width: 150px;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #574fd6, #6c63ff);
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

        </style>

<hbox align = "center" pack = "center" width="100%" height = "100%" style = " background-color: #003366;">
<window zclass="form-container" vflex="1" border="normal" apply="com.fintrust.admin.controller.AccountUpdateApprovalController">

     <hbox width="100%" pack="center" align="center">
     	<label value="Accounts Update Request" style="font-weight:bold; font-size:20px;" />
     	<space />
     	<textbox id="searchBox" placeholder="Search by Account No" width="90%" onOK="@command('searchAccount')" />
     	<button id="searchBtn" label="Search" />
     </hbox>
     <space />
     <listbox id="requestList" width="100%" mold="paging" pageSize="5" vflex="100%">
        <listhead>
            <listheader label="Request Id" width="100px"/>
            <listheader label="Account No"/>
            <listheader label="Status"/>
            <listheader label="Requested By"/>
            <listheader label="Requested At"/>
        </listhead>
        <template name="model">
            <listitem>
                <listcell label="${each.requestId}"/>
                <listcell label="${each.accountNo}"/>
                <listcell label="${each.status}"/>
                <listcell label="${each.requestedBy.fullName}"/>
                <listcell label="${each.requestDate}"/>
            </listitem>
        </template>
    </listbox>
    
    <!-- NO DATA MESSAGE (REUSABLE) -->
   <hbox id="messageBox" width="100%" height="50px" align="center" pack="center" visible="false">
   	 <label value="No Account Pending for Approval" style="font-size:22px;font-weight:bold;color:#666;" />
   </hbox>
</window>
</hbox>
</zk>