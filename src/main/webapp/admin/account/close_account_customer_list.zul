<?page title="new page title" contentType="text/html;charset=UTF-8"?>
<zk>


   <style>
    body {
        margin: 0;
        background: linear-gradient(135deg, #74ebd5, #ACB6E5);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-container {
        min-width: 40%;
        max-width: 90%;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        background-color: #fff;
        animation: fadeIn 0.5s ease-in;
        margin: 20px auto;
        box-sizing: border-box;
    }

    @keyframes fadeIn {
        0% {opacity: 0; transform: translateY(20px);}
        100% {opacity: 1; transform: translateY(0);}
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6c63ff, #8e7dff);
        color: white;
        border: none;
        padding: 10px 0;
        border-radius: 10px;
        font-size: 12pt;
        cursor: pointer;
        transition: 0.3s all;
        width: 150px;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #574fd6, #6c63ff);
        transform: translateY(-2px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
    }

    /* === Responsive Design === */

    /* Tablet screens */
    @media (max-width: 1024px) {
        .form-container {
            width: 70%;
            padding: 20px;
        }

        label {
            font-size: 14px;
        }

        .btn-primary {
            width: 130px;
            font-size: 11pt;
        }
    }

    /* Mobile screens */
    @media (max-width: 768px) {
        .form-container {
            width: 90%;
            padding: 15px;
        }

        grid, hbox, row {
            display: block;
            width: 100%;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 13px;
        }

        textbox, combobox, doublebox, longbox {
            width: 50% !important;
        }

        .btn-primary {
            width: 100%;
            margin-top: 10px;
        }

    }
</style>

<hbox align = "center" pack = "center" width="100%" height = "100%" style = " background-color: #003366;">
<window zclass="form-container" vflex="1" border="normal" apply="com.fintrust.admin.controller.AccountCloseApprovelComposer">

	<hbox width="100%" pack="center" align="center">
     	<label value="Accounts Close Request" style="font-weight:bold; font-size:20px;" />
     	<space />
     	<textbox id="searchBox" placeholder="Search by Account No" width="90%" onOK="@command('searchAccount')" />
     	<button id="searchBtn" label="Search" />
     </hbox>
	 <space/>
    <listbox id="requestList" width="100%" mold="paging" pageSize="5" vflex="100%">
       <listhead>
       		<listheader width="100px">Request ID</listheader>
       		<listheader>accountNo</listheader>
       		<listheader>Request By</listheader>
       		<listheader>Requested At</listheader>
       		<listheader>Reason</listheader>
       			
       </listhead>
       <template name="model">
       		<listitem>
       			<listcell label="${each.requestId}"></listcell>
       			<listcell label="${each.accountNo}"></listcell>
       			<listcell label="${each.requestedBy.fullName}"></listcell>
       			<listcell label="${each.requestDate}"></listcell>
       			<listcell label="${each.reason}"></listcell>
       			
       		</listitem>
       </template>
    </listbox> 
    
   <!-- NO DATA MESSAGE (REUSABLE) -->
   <hbox id="messageBox" width="100%" height="50px" align="center" pack="center" visible="false">
   	 <label value="No Account Pending for Approval" style="font-size:22px;font-weight:bold;color:#666;" />
   </hbox>
   
   <hbox align="center" spacing="10px" style="margin-top:10px;">
        <button id="approveBtn" label="Approve" sclass="btn-primary"/>
        <button id="rejectBtn" label="Reject" sclass="btn-primary"/>
    </hbox>
</window>
</hbox>
</zk>