<?page title="All Accounts" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<style>
    .container {
        min-width: 40%;
        max-width: 90%;
        margin: 30px auto;
        background: #fff;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        animation: fadeIn 0.5s ease-in;
    }
    
      @keyframes fadeIn {
        0% {opacity: 0; transform: translateY(20px);}
        100% {opacity: 1; transform: translateY(0);}
    }

    .btn {
        background: linear-gradient(135deg, #6c63ff, #8e7dff);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px;
        cursor: pointer;
        transition: 0.3s all;
    }

    listbox:hover {
        cursor: pointer;
    }

    @media (max-width: 600px) {
        .container { width: 100%; padding: 15px; }
    }
</style>

<hbox align = "center" pack = "center" width="100%" height = "100%" style = " background-color: #003366;">
<window border="normal" vflex="1" zclass="container" apply="com.fintrust.admin.controller.AllAccounts">

    <vlayout spacing="15px" hflex="1" vflex="1">
        
        <hbox hflex="1" pack="center" align="center">
        <label value="User Accounts" style="font-weight:bold; font-size:20px;"/>
           <space/>
            <textbox id="searchBox" placeholder="Search by Account No"
                     width="90%" onOK="@command('searchAccount')"/>
            <button id="searchBtn" label="Search"/>
        </hbox>

        <listbox id="accountListbox" mold="paging" pageSize="5" vflex="1" width="100%">
            <listhead>
                <listheader label="Account No" width="20%"/>
                <listheader label="Type" width="20%"/>
                <listheader label="Balance" width="20%"/>
                <listheader label="Status" width="15%"/>
            </listhead>
        </listbox>

       <!--  <hbox pack="center" style="margin-top:15px;">
            <button id="backBtn" label="Back to Dashboard" sclass="btn"/>
        </hbox> -->
    </vlayout>
</window>
</hbox>
</zk>