<zk>

	<style>
		.form-container { min-width: 40%; /* Prevent it from shrinking
		too much */ max-width: 90%; /* Prevent it from stretching too
		wide */ border-radius: 15px; padding: 20px; box-shadow: 0 5px
		15px rgba(0,0,0,0.2); background-color: #fff; animation: fadeIn
		0.5s ease-in; margin: 0px auto; }

		label { font-weight: bold; color: #333; }


		.btn-primary { background: linear-gradient(135deg, #6c63ff,
		#8e7dff); color: white; border: none; padding: 10px 0;
		border-radius: 10px; font-size: 12pt; cursor: pointer;
		transition: 0.3s all; width: 150px; }

		.btn-primary:hover { background: linear-gradient(135deg,
		#574fd6, #6c63ff); transform: translateY(-2px); box-shadow: 0
		3px 10px rgba(0,0,0,0.2); }

	</style>

	<hbox align="center" pack="center" width="100%" height="100%"
		style=" background-color: #B7AEC8;">
		<window title="Pending Card Requests" sclass="form-container"
			border="normal"
			apply="com.fintrust.cards.controller.CardApprovalController">
			<listbox id="requestList" width="100%" mold="paging"
				pageSize="5">
				<listhead>
					<listheader label="Request Id" />
					<listheader label="User ID" />
					<listheader label="Account Number" />
					<listheader label="Card Type" />
					<listheader label="Card Category" />
					<listheader label="Remark" />
					<listheader label="Requested At" />
				</listhead>
				<template name="model">
					<listitem>
						<listcell label="${each.request_no}" />
						<listcell label="${each.user_id}" />
						<listcell label="${each.account_no}" />
						<listcell label="${each.card_type}" />
						<listcell label="${each.card_category}" />
						<listcell label="${each.remarks}" />
						<listcell label="${each.requested_at}" />
					</listitem>
				</template>
			</listbox>
			<hbox align="center" pack="center" hflex="1"
				style="padding-top:10px;">
				<button id="approveBtn" label="Approve"
					sclass="btn-primary" />
				<space />
				<button id="rejectBtn" label="Reject"
					sclass="btn-primary" />
			</hbox>
		</window>
	</hbox>
</zk>