<?page title="Account Detail" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<?init class="com.fintrust.security.AuthenticationController"?>

<style>
    .outer-bg {
        background-color: #B7AEC8;;
        padding: 30px;
    }

    .account-box {
        width: 90vw;
        height: 68vh;
        min-width: 500px;         /* Prevent it from shrinking too much */
        max-width: 800px;   
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 15px rgba(0,0,0,0.18);
        
        padding-top: 0px;
    	padding-left: 20px;
    	padding-right: 20px;
    	padding-bottom: 0px;   /* Bottom = 0 */
        
        display: flex;
        flex-direction: column;
        animation: fadeIn 0.5s ease-in;
    }

   @keyframes fadeIn {
        0% {opacity: 0; transform: translateY(20px);}
        100% {opacity: 1; transform: translateY(0);}
    }

    .scroll-content {
        flex: 1;
        overflow-y: auto;
        padding-right: 6px;
    }

    label {
        font-weight: bold;
        color: #2c3e50;
    }

    .btn {
        background: linear-gradient(135deg, #6c63ff, #8e7dff);
        color: #fff;
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: bold;
    }
</style>

<hbox width="100%" height="100%" align="center" pack="center" sclass="outer-bg" style=" background-color: #003366;">

    <!-- KEEP YOUR MVC CONTROLLER -->
    <window border="none"
            sclass="account-box"
            apply="com.fintrust.admin.controller.userPopupDetails"
			id="container">
        <!-- Header -->
        <hbox align="center" pack="center" spacing="5px" height="30px" width="100%">
			<label value="User Details" style="font-weight:bold; font-size:23px; color:#003366"/>
		</hbox>

        <!-- SCROLLABLE AREA -->
        <vlayout width="100%" vflex="1" sclass="scroll-content">

            <grid width="100%">
                <rows>
                    <row>
                        <label value="Name: "/>
                        <label id="userNameLabel"/>
                    </row>
                    <row>
                        <label value="Email: "/>
                        <label id="userEmailLabel"/>
                    </row>
                    <row>
                        <label value="Gender: "/>
                        <label id="userGenderLabel"/>
                    </row>
                    <row>
                        <label value="Date Of Birth: "/>
                        <label id="userDOBLabel"/>
                    </row>
                    <row>
                        <label value="District: "/>
                        <label id="userDistrictLabel"/>
                    </row>
                    <row>
                        <label value="State: "/>
                        <label id="userStateLabel"/>
                    </row>
                    <row>
                        <label value="Country: "/>
                        <label id="userCountryLabel"/>
                    </row>
                </rows>
            </grid>

        </vlayout>

        <!-- Footer Button -->
        <hbox width="100%" align="center" pack="center" style="margin-top:15px;">
            <button id="closeBtn" label="Close" sclass="btn"/>
        </hbox>

    </window>

</hbox>

</zk>
