<?page title="Account Detail" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<?init class="com.fintrust.security.AuthenticationController"?>

<style>
    .outer-bg {
        background-color: #B7AEC8;
        padding: 30px;
    }

    .account-box {
        width: 90%;
        max-width: 650px;
        height: 90vh;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 15px rgba(0,0,0,0.18);
        padding: 20px;
        display: flex;
        flex-direction: column;
    }

    .scroll-content {
        flex: 1;
        overflow-y: auto;
        padding-right: 6px;
    }

    label {
        font-weight: bold;
        color: #2c3e50;
    }

    .btn {
        background: linear-gradient(135deg, #6c63ff, #8e7dff);
        color: #fff;
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: bold;
    }
</style>

<hbox width="100%" height="100%" align="center" pack="center" sclass="outer-bg">

    <!-- KEEP YOUR MVC CONTROLLER -->
    <window border="none" apply="com.fintrust.controller.SingleAccountDetails"
            sclass="account-box">

        <!-- Header -->
        <hbox width="100%" height="40px" align="center" pack="center">
            <label value="Account Detail" style="font-size:22px;" />
        </hbox>

        <!-- SCROLLABLE AREA -->
        <vlayout width="100%" vflex="1" sclass="scroll-content">

            <grid width="100%">
                <rows>
                    <row>
                        <label value="Account No:"/>
                        <label id="accountNo"/>
                    </row>
                    <row>
                        <label value="Account Type:"/>
                        <label id="accountType"/>
                    </row>
                    <row>
                        <label value="Balance:"/>
                        <label id="accountBalance"/>
                    </row>
                    <row>
                        <label value="Status:"/>
                        <label id="accountStatus"/>
                    </row>
                    <row>
                        <label value="Branch:"/>
                        <label id="accountBranch"/>
                    </row>
                    <row>
                        <label value="IFSC Code:"/>
                        <label id="ifscCode"/>
                    </row>
                    <row>
                        <label value="Mode of Operation:"/>
                        <label id="modeOfOperation"/>
                    </row>
                    <row>
                        <label value="Nominee ID:"/>
                        <label id="nomineeId"/>
                    </row>
                </rows>
            </grid>

        </vlayout>

        <!-- Footer Button -->
        <hbox width="100%" align="center" pack="center" style="margin-top:15px;">
            <button id="backBtn" label="Back to All Accounts" sclass="btn"/>
        </hbox>

    </window>

</hbox>

</zk>
