<!-- ============================================================
 Page Name: userHome.zul
 Purpose: FinTrust user home page after login
 Features: Responsive navbar, hero section, features, and footer
 Controller: UserHomeController.java
 ============================================================ -->

<?page title="FinTrust Bank - Home" contentType="text/html;charset=UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/resources/css/home.css"?>

<zk xmlns:h="xhtml">
    <window border="none" sclass="home-window">

        <!-- Navbar -->
        <div sclass="navbar">
            <div sclass="navbar-left">
                <image src="/resources/images/logo.png" sclass="navbar-logo"/>
                <label value="FinTrust Bank" sclass="navbar-title"/>
            </div>

            <div sclass="navbar-right">
                <a href="/user/userHome.zul" label="Home" sclass="nav-link active"/>
                <a href="/user/userAccounts.zul" label="Accounts" sclass="nav-link"/>
                <a href="/user/userTransactions.zul" label="Transactions" sclass="nav-link"/>
                <a href="/user/userCards.zul" label="Cards" sclass="nav-link"/>
                <a href="/user/userProfile.zul" label="Profile" sclass="nav-link"/>
                <a href="/user/userLogin.zul" label="Logout" sclass="logout-btn"/>
            </div>
        </div>

        <!-- Hero Section -->
        <div sclass="hero-section">
            <div sclass="hero-text">
                <label value="Welcome to FinTrust Bank" sclass="hero-heading"/>
                <label value="Secure. Reliable. Seamless Banking for Everyone." sclass="hero-subheading"/>
                <button label="Explore Your Account" sclass="hero-btn"/>
            </div>
            <div sclass="hero-image">
                <image src="/resources/images/hero-bank.png" sclass="hero-img"/>
            </div>
        </div>

        <!-- Features -->
        <div sclass="feature-section">
            <div sclass="feature-card">
                <image src="/resources/images/account.png" sclass="feature-icon"/>
                <label value="Smart Accounts" sclass="feature-title"/>
                <label value="Open, view and manage all your accounts securely." sclass="feature-desc"/>
            </div>

            <div sclass="feature-card">
                <image src="/resources/images/transfer.png" sclass="feature-icon"/>
                <label value="Quick Transfers" sclass="feature-title"/>
                <label value="Send and receive funds instantly across banks." sclass="feature-desc"/>
            </div>

            <div sclass="feature-card">
                <image src="/resources/images/card.png" sclass="feature-icon"/>
                <label value="Digital Cards" sclass="feature-title"/>
                <label value="Track and control all your debit and credit cards easily." sclass="feature-desc"/>
            </div>

            <div sclass="feature-card">
                <image src="/resources/images/support.png" sclass="feature-icon"/>
                <label value="24x7 Support" sclass="feature-title"/>
                <label value="We’re here to help you anytime, anywhere." sclass="feature-desc"/>
            </div>
        </div>

        <!-- Footer -->
        <div sclass="footer">
            <label value="© 2025 FinTrust Bank. All Rights Reserved."/>
        </div>
    </window>
</zk>
