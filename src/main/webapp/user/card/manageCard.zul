  
   <?link rel="stylesheet" type="text/css" href="/resources/css/header-footer.css"?>

<zk>

    <!-- ================= FIXED NAVBAR ================= -->
   <privateNavbar width="100%"></privateNavbar>

    <!-- ================= MAIN CONTENT ================= -->
    <window width="100%"
            apply="com.fintrust.cards.controller.manageCardController"
            class="page-container">

        <vlayout spacing="20px" class="content-wrapper">

            <!-- ===== HEADER ===== -->
            <div class="page-header">

                <!-- Back Button -->
                <button label="← Back"
                        onClick='Executions.sendRedirect("/user/card/cardHome.zul")'
                        class="back-btn"/>

                <!-- Center Title -->
                <label value="Manage Existing Cards"
                       class="page-title"/>
            </div>

            <!-- ===== RESPONSIVE TABLE WRAPPER ===== -->
            <div class="table-scroll">

                <listbox id="cardListbox"
                         mold="paging"
                         pageSize="6"
                         width="100%"
                         height="450px"
                         class="card-table">

                    <listhead>
                        <listheader label="ATM Card No" width="180px"/>
                        <listheader label="Card Type" width="140px"/>
                        <listheader label="Account No" width="160px"/>
                        <listheader label="Issued Date" width="130px"/>
                        <listheader label="Expiry Date" width="130px"/>
                        <listheader label="Status" width="120px"/>
                        <listheader label="Action" width="150px"/>
                    </listhead>

                    <template name="model">
                        <listitem>
                            <listcell label="${each[0]}" />
                            <listcell label="${each[1]}" />
                            <listcell label="${each[2]}" />
                            <listcell label="${each[3]}" />
                            <listcell label="${each[4]}" />
                            <listcell label="${each[5]}" />
                            <listcell>
                                <button label="Manage" class="manage-btn"/>
                            </listcell>
                        </listitem>
                    </template>

                </listbox>

            </div>

        </vlayout>
    </window>

    <!-- ================= RESPONSIVE CSS ================= -->
    <style>
        /* Navbar */
        .navbar-fixed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
        }

        /* Page layout */
        .page-container {
            padding-top: 60px; /* navbar height */
        }

        .content-wrapper {
            padding: 20px;
        }

        /* Header */
        .page-header {
            position: relative;
            height: 44px;
        }

        .back-btn {
            position: absolute;
            left: 0;
            background: #004080;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 14px;
            font-weight: bold;
            cursor: pointer;
        }

        .page-title {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            font-size: 24px;
            font-weight: bold;
            color: #004080;
            white-space: nowrap;
        }

        /* Table */
        .card-table {
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .manage-btn {
            padding: 4px 10px;
            font-size: 13px;
            background: #0a66c2;
            color: white;
            border: none;
            border-radius: 6px;
        }

        /* ===== MOBILE RESPONSIVE ===== */
        @media (max-width: 600px) {

            /* horizontal scroll only when needed */
            .table-scroll {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .card-table {
                min-width: 1000px; /* forces horizontal scroll */
            }

            .page-title {
                font-size: 18px;
            }

            .back-btn {
                padding: 5px 10px;
                font-size: 12px;
            }
        }
    </style>

</zk>
   
   
   
   