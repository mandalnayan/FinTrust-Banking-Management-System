<?link rel="stylesheet" type="text/css" href="/resources/css/header-footer.css"?>

<zk>

    <!-- ================= FIXED NAVBAR ================= -->
    <privateNavbar width="100%" />

    <!-- ================= MAIN WINDOW ================= -->
    <window border="none" width="100%" height="100%"
            apply="com.fintrust.cards.controller.card_status_controller"
            sclass="page-root">

        <!-- ================= CONTENT WRAPPER ================= -->
        <div sclass="page-container">

            <!-- ================= HEADER CARD ================= -->
            <div sclass="header-card">
                <button label="← Back"
                        onClick='Executions.sendRedirect("/user/card/cardHome.zul")'
                        sclass="back-btn" />

                <label value="Manage Card Requests" sclass="page-title" />
                <label value="Track and manage your ATM / Debit card requests"
                       sclass="page-subtitle" />
            </div>

            <!-- ================= DATA CARD ================= -->
            <div sclass="data-card">

                <listbox id="atmRequestList"
                         mold="paging"
                         pageSize="5"
                         pagingPosition="bottom"
                         sclass="responsive-listbox">

                    <listhead>
                        <listheader label="Request No" />
                        <listheader label="Account No" />
                        <listheader label="Card Type" />
                        <listheader label="Category" />
                        <listheader label="Address" />
                        <listheader label="Remarks" />
                        <listheader label="Status" />
                    </listhead>

                    <template name="model">
                        <listitem>
                            <listcell label="${each.requestNo}" />
                            <listcell label="${each.accountNo}" />
                            <listcell label="${each.cardType}" />
                            <listcell label="${each.cardCategory}" />
                            <listcell label="${each.address}" />
                            <listcell label="${each.remarks}" />
                            <listcell>
                                <label value="${each.status}" sclass="status-label ${each.status}" />
                            </listcell>
                        </listitem>
                    </template>

                </listbox>

            </div>
        </div>

        <!-- ================= STYLES ================= -->
        <style>
            /* ===== ROOT ===== */
            .page-root {
                background: linear-gradient(135deg, #eef4ff, #ffffff);
                overflow: auto;
            }

            .page-container {
                padding: 90px 20px 30px;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 20px;
            }

            /* ===== HEADER CARD ===== */
            .header-card {
                width: 100%;
                max-width: 1100px;
                background: white;
                border-radius: 14px;
                padding: 20px 20px 18px;
                box-shadow: 0 6px 18px rgba(0,0,0,0.08);
                position: relative;
                text-align: center;
            }

            .page-title {
                font-size: 22px;
                font-weight: 700;
                color: #003366;
                display: block;
            }

            .page-subtitle {
                font-size: 13px;
                color: #666;
                margin-top: 4px;
                display: block;
            }

            .back-btn {
                position: absolute;
                left: 16px;
                top: 16px;
                background: #f5f7fb;
                color: #004080;
                padding: 6px 14px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 600;
                border: none;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .back-btn:hover {
                background: #004080;
                color: white;
                transform: translateX(-3px);
            }

            /* ===== DATA CARD ===== */
            .data-card {
                width: 100%;
                max-width: 1100px;
                background: white;
                border-radius: 14px;
                padding: 16px;
                box-shadow: 0 6px 18px rgba(0,0,0,0.08);
            }

            /* ===== LISTBOX ===== */
            .responsive-listbox {
                border: none;
            }

            listheader {
                font-weight: 600;
                background: #f3f6fb;
            }

            listcell label {
                white-space: normal;
                word-break: break-word;
                font-size: 13px;
            }

            /* ===== STATUS BADGES ===== */
            .status-label {
                padding: 4px 10px;
                border-radius: 14px;
                font-size: 12px;
                font-weight: 600;
                display: inline-block;
            }

            .status-label.PENDING {
                background: #fff3cd;
                color: #856404;
            }

            .status-label.APPROVED {
                background: #e6f4ea;
                color: #2e7d32;
            }

            .status-label.REJECTED {
                background: #fdecea;
                color: #c62828;
            }

            /* ===== TABLET ===== */
            @media (max-width: 768px) {
                .page-container {
                    padding-top: 80px;
                }

                listcell label {
                    font-size: 12px;
                }
            }

            /* ===== MOBILE ===== */
            @media (max-width: 480px) {
                .header-card,
                .data-card {
                    padding: 12px;
                }

                .page-title {
                    font-size: 18px;
                }

                .page-subtitle {
                    font-size: 12px;
                }
            }
        </style>

    </window>
</zk>
