<?page title="Reset Password - FinTrust Bank" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/resources/css/reset-password-minimal.css"?>

<zk xmlns:h="xhtml">

    <window
        title=" "
        width="400px"
        mode="popup"
        closable="true"
        sizable="false"
        position="center"
        border="none"
        sclass="reset-window">

        <vlayout spacing="16px"
                 sclass="reset-container"
                 apply="com.fintrust.controller.ResetPasswordController">

            <label value="Change Password" sclass="reset-title"/>
            <label value="Update your account password"
                   sclass="reset-subtitle"/>
			 <div sclass="pwd-wrapper" width="100%">
            <textbox id="oldPassword"
                     type="password"
                     placeholder="Current password"
                     sclass="reset-input"/>
<button id="toggleOldPwd" iconSclass="z-icon-eye"
						sclass="pwd-toggle-btn" tooltiptext="Show Password" />
            </div>
            <div sclass="pwd-wrapper" width="100%">
            <textbox id="password"
                     type="password"
                     placeholder="New password"
                     sclass="reset-input"/>
<button id="togglePwd" iconSclass="z-icon-eye"
						sclass="pwd-toggle-btn" tooltiptext="Show Password" />
            </div>
             <div sclass="pwd-wrapper" width="100%">
            <textbox id="confirmPassword"
                     type="password"
                     placeholder="Confirm new password"
                     sclass="reset-input"/>
<button id="togglePwd_confPwd" iconSclass="z-icon-eye"
						sclass="pwd-toggle-btn" tooltiptext="Show Password" />
						</div>
            <button id="changePswBtn"
                    label="Update Password"
                    sclass="reset-btn"/>

            <a href="/auth/forgotPassword.zul"
               sclass="reset-link">
                Forgot password?
            </a>

        </vlayout>
    </window>
    
    <style>
    * {
    box-sizing: border-box;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* Window */
.reset-window {
    background: transparent;
}

/* Container */
.reset-container {
    background: #ffffff;
    padding: 26px 28px;
    border-radius: 12px;
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.12);
}

/* Title */
.reset-title {
    font-size: 21px;
    font-weight: 600;
    text-align: center;
    color: #1f2937;
}

.reset-subtitle {
    font-size: 13px;
    text-align: center;
    color: #6b7280;
    margin-bottom: 6px;
}

/* Inputs */
.reset-input {
    width: 100%;
    height: 44px;
    padding: 10px 14px;
    font-size: 14px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    transition: border 0.2s ease, box-shadow 0.2s ease;
}

.reset-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
}

/* Button */
.reset-btn {
    width: 100%;
    height: 46px;
    margin-top: 6px;
    background: linear-gradient(135deg, #2563eb, #1e40af);
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    border-radius: 10px;
    border: none;
    cursor: pointer;
}

.reset-btn:hover {
    box-shadow: 0 10px 18px rgba(37, 99, 235, 0.3);
}

/* Status */
.reset-status {
    text-align: center;
    font-size: 13px;
    color: #dc2626;
}

/* Link */
.reset-link {
    text-align: center;
    font-size: 13px;
    color: #2563eb;
    text-decoration: none;
}

.reset-link:hover {
    text-decoration: underline;
}
    
    </style>
</zk>
