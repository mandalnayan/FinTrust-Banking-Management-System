<?xml version="1.0" encoding="UTF-8"?>
<zk>

<window width="100%" height="100%" border="normal"
    apply="com.fintrust.controller.FundTransferController"
    sclass="main-window">

    <vlayout vflex="1" hflex="1" sclass="main-layout">

        <!-- HEADER -->
        <vbox sclass="header" align="center" pack = "center" hflex="1">
            <label value="Fund Transfer Portal" sclass="title"/>
            <label value="Secure and Fast Money Transfer" sclass="subtitle"/>
        </vbox>

        <separator bar="true"/>

        <!-- SCROLLABLE FORM AREA -->
        <div vflex="1" sclass="form-scroll">

            <vlayout sclass="form-wrapper" width="100%" spacing="20px">

                <!-- First Row -->
                <hbox spacing="20px" class="form-row">
                    <vbox hflex="1">
                        <label value="From Account"/>
                        <combobox id="accountsComboBox" width="100%" autodrop="true"
                                  placeholder="Select your account"/>
                    </vbox>

                    <vbox hflex="1">
                        <label value="Beneficiary"/>
                        <combobox id="beneficiaryComboBox" width="100%" autodrop="true"
                                  placeholder="Select beneficiary"/>
                    </vbox>
                </hbox>

                <!-- Second Row -->
                <hbox spacing="20px" class="form-row">
                    <vbox hflex="1">
                        <label value="To Account"/>
                        <longbox id="toAccountBox" width="100%" placeholder="Enter account number"/>
                    </vbox>

                    <vbox hflex="1">
                        <label value="IFSC Code"/>
                        <textbox id="ifsccodeBox" width="100%" placeholder="Enter IFSC code"/>
                    </vbox>
                </hbox>

                <!-- Third Row -->
                <hbox spacing="20px" class="form-row">
                    <vbox hflex="1">
                        <label value="Amount"/>
                        <doublebox id="amountBox" width="100%" placeholder="Enter amount"/>
                    </vbox>

                    <vbox hflex="1">
                        <label value="Remarks"/>
                        <textbox width="100%" placeholder="Optional notes" maxlength="100"/>
                    </vbox>
                </hbox>

            </vlayout>
        </div>

        <!-- ACTION BAR -->
        <div sclass="action-bar">
            <button id="transferBtn" label="Transfer Funds" sclass="btn-primary"/>
            <button id="clearBtn" label="Clear" sclass="btn-secondary"/>
            <button id = "addBeneiciary" label="Add Beneficiary" sclass="btn-outline"/>
        </div>

    </vlayout>
</window>

<style>
/* ROOT WINDOW */
.main-window {
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    font-family: 'Poppins', sans-serif;
}

/* HEADER */
.header { text-align: center; padding: 20px 10px; }
.title { font-size: 26px; font-weight: 700; color: #1e3a8a; }
.subtitle { font-size: 14px; color: #6b7280; }

/* FORM SCROLL AREA */
.form-scroll { padding: 20px; overflow-y: auto; }
.form-wrapper .form-row { display:flex; gap:20px; }

/* INPUTS */
.z-textbox, .z-longbox, .z-doublebox, .z-combobox {
    border-radius: 8px;
    border: 1px solid #d1d5db;
   // padding: 8px 10px;
    font-size: 14px;
    width: 100%;
}
.z-textbox:focus, .z-longbox:focus, .z-doublebox:focus, .z-combobox:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
}

/* ACTION BAR */
.action-bar {
    position: sticky;
    bottom: 0;
    background: #ffffff;
    padding: 16px;
    border-top: 1px solid #e5e7eb;
    display: flex;
    justify-content: center;
    gap: 16px;
}
.z-button { border-radius: 8px; font-weight: 600; }
.btn-primary { background: linear-gradient(135deg,#1e3a8a,#2563eb); color:white; }
.btn-secondary { background:#e5e7eb; color:#111827; }
.btn-outline { background:white; border:1px solid #2563eb; color:#2563eb; }

/* MOBILE RESPONSIVE */
@media (max-width: 768px) {
    .form-wrapper .form-row { flex-direction: column !important; }
    .action-bar { flex-direction: column; align-items: stretch; }
    .action-bar .z-button { width: 100%; }
}
</style>

</zk>
