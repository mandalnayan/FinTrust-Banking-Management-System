<zk>

    <window border="normal" width="90%" 
            apply="com.fintrust.controller.FundTransferController"
            style="border-radius: 12px; background-color: #ffffff; 
                   box-shadow: 0 8px 20px rgba(0,0,0,0.12); margin: auto; padding: 20px;">

        <!-- TITLE -->
        <hbox pack="center" style="margin-bottom:20px;">
            <label value="Fund Transfer Portal"
                   style="font-size:26px; font-weight:bold; color:#1e3a8a;"/>
        </hbox>

        <separator bar="true"/>

        <!-- FORM CONTAINER -->
        <div sclass="form-scroll">
            <grid sclass="form-grid responsive-grid" style="width:100%;">
                <rows>

                    <row>
                        <label value="From Account:"/>
                        <combobox id = "accountsComboBox" width="100%" popupWidth="100%" autodrop="true" placeholder="Select your account"/>
                    </row>

                    <row>
                        <label value="Beneficiary:"/>
                        <combobox id = "beneficiaryComboBox" width="100%" autodrop="true" placeholder="Select beneficiary"/>
                    </row>

                    <row>
                        <label value="To Account:"/>
                        <longbox id = "toAccountBox" width="100%" placeholder="Enter account number"/>
                    </row>

                    <row>
                        <label value="IFSC Code:"/>
                        <textbox id = "ifsccodeBox" width="100%" placeholder="Enter IFSC code"/>
                    </row>

                    <row>
                        <label value="Amount:"/>
                        <doublebox id = "amountBox" width="100%" placeholder="Enter amount"/>
                    </row>

                    <row>
                        <label value="Remarks:"/>
                        <textbox width="100%" placeholder="Optional notes" maxlength="100"/>
                    </row>

                </rows>
            </grid>
        </div>

        <!-- ACTION BUTTONS -->
        <hbox sclass="action-bar" pack="center" spacing="20px" style="margin-top:20px;">
            <button id = "transferBtn" label="Transfer Funds" style="background-color:#1e3a8a;color:white;font-weight:bold;"/>
            <button id = "clearBtn" label="Clear" style="background-color:#e5e7eb;color:#111;font-weight:bold;"/>
            <button label="Add Beneficiary" style="background-color:#2563eb;color:white;font-weight:bold;"/>
        </hbox>

    </window>

    <style>
        /* SCROLLABLE FORM */
        .form-scroll {
            max-height: 60vh;
            overflow-y: auto;
            padding-right: 10px;
        }
        .form-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .form-scroll::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.2);
            border-radius: 3px;
        }

        /* GRID ROWS */
        .form-grid .z-row {
            padding: 12px 0;
        }
        .form-grid .z-label {
            font-weight: 600;
            font-size: 14px;
            min-width: 120px;
        }
<!--         .z-combobox, .z-textbox, .z-longbox, .z-doublebox {
            border-radius: 6px;
            border: 1px solid #d1d5db;
            padding: 6px 10px;
            font-size: 14px;
        } -->

        /* BUTTON STYLES */
        .z-button {
            border-radius: 6px;
            padding: 8px 20px;
            font-size: 14px;
            transition: 0.2s all;
        }
        .z-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            cursor: pointer;
        }

        /* RESPONSIVE DESIGN: MOBILE SINGLE COLUMN */
        @media (max-width: 768px) {

            /* Stack labels above inputs */
             /* Combobox input itself */
    .z-combobox, .z-textbox, .z-longbox, .z-doublebox {
        width: 100% !important;
    }

    /* Combobox popup */
    .z-combobox-popup {
        width: auto !important;
        max-width: 95vw !important;
        min-width: 100px !important;
        height: auto !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
        box-sizing: border-box;
    }

    /* Stack labels above inputs */
    .responsive-grid .z-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .action-bar {
        flex-direction: column !important;
        gap: 12px;
    }
            
            
            .responsive-grid .z-row {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .responsive-grid .z-row .z-label {
                width: 100%;
                margin-bottom: 2px;
            }

            .z-combobox, .z-textbox, .z-longbox, .z-doublebox {
                width: 100% !important;
            }

            /* Stack buttons vertically */
            .action-bar {
                flex-direction: column !important;
                gap: 12px;
            }
        }
    </style>
</zk>
