<?page title="Verify OTP - FinTrust Bank" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/resources/css/reset-password-minimal.css"?>

<zk xmlns:h="xhtml">

    <window
    title=""
        width="400px"
        mode="popup"
        closable="true"
        sizable="false"
        position="center"
        border="none"
        sclass="reset-window"
        viewModel="@id('vm') @init('com.fintrust.viewModel.OtpVerificationVM')">

        <vlayout spacing="16px"
                 sclass="reset-container">

            <label value="OTP Verification"
                   sclass="reset-title"/>

            <label value="Enter the 6-digit OTP sent to your registered email or phone"
                   sclass="reset-subtitle"/>

            <textbox id="otp"
                     placeholder="Enter 6-digit OTP"
                     maxlength="6"
                     sclass="reset-input"
                     constraint="no empty"
                     value="@bind(vm.otpCode)"/>

            <button label="Verify OTP"
                    sclass="reset-btn"
                    onClick="@command('verifyOtp')"/>

            <label value="@bind(vm.statusMessage)"
                   sclass="reset-status"
                   style="color:#2563eb"/>

            <a href="#"
               sclass="reset-link"
               onClick="@command('resendOtp')">
                Resend OTP
            </a>

        </vlayout>
    </window>
</zk>
