<?page title="Transaction History" contentType="text/html;charset=UTF-8"?>
<zk>
    <window 
      
        closable="false"
        sizable="true"
        vflex="1"
        hflex="1"
       apply="com.fintrust.transaction.UpdatedTransactionHistoryController"
        >

        <vlayout spacing="10px" vflex="1" hflex="1">

            <!-- Header -->
            <hlayout width="100%" spacing="10px" style="align-items:center;">
                <label value="💳 ttTransaction History"
                       style="font-weight:bold; font-size:18px; color:#2b4b80;"/>

                <button label="⟳ Refresh" sclass="btn-refresh" 
                    style="background:#2563eb; color:white; border:none; border-radius:6px; padding:6px 12px; font-weight:600; cursor:pointer;"
                    onClick='Executions.sendRedirect(null);'/>

                <!-- NEW BUTTON FOR PDF DOWNLOAD -->
                <button id="btnDownloadPdf"
                        label="📄 Download 53-Month Statement"
                        style="background:#1e293b; color:white; border:none; 
                               border-radius:6px; padding:6px 12px; 
                               font-weight:600; cursor:pointer; margin-left:auto;"/>
            </hlayout>

            <!-- Date range filter -->
            <hlayout width="100%" spacing="8px" style="margin-bottom:10px; align-items:center;">
                <label value="📅 From:"/>
                <datebox id="fromDate" width="150px"/>

                <label value="To:"/>
                <datebox id="toDate" width="150px"/>

                <button id="filterBtn" label="Show Transactions"
                        style="background:#16a34a; color:white; border:none; border-radius:6px; padding:6px 12px; font-weight:600; cursor:pointer;"/>
            </hlayout>

            <!-- Transaction list -->
            <listbox id="transactionListbox"
                     vflex="1"
                     hflex="1"
                     mold="paging"
                     pageSize="10"
                     sizedByContent="true"
                     style="border:1px solid #ccc; border-radius:8px;">
               <listhead hflex="1">
					<listheader label="T_ID" width="auto" sort="auto"/>
					<listheader label="From Account" width="auto" sort="auto"/>
					<listheader label="To Account" width="auto" sort="auto"/>
					<listheader label="Amount" width="auto" sort="auto"/>
					<listheader label="Status" width="auto" sort="auto"/>
					<listheader label="Date" width="auto" sort="auto"/>
					<listheader label="Mode" width="auto" sort="auto"/>
					<listheader label="Balance" width="auto" sort="auto"/>
					<listheader label="Type" width="auto" sort="auto"/>
			</listhead>
            </listbox>

        </vlayout>
    </window>
</zk>
 
 

