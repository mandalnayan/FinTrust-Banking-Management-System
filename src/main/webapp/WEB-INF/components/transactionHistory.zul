<?page title="Transaction History" contentType="text/html;charset=UTF-8"?>
<zk>
    <window
        closable="false"
        sizable="true"
        vflex="1"
        hflex="1"
        apply="com.fintrust.controller.NewTransactionHistoryController">

        <vlayout vflex="1" hflex="1" spacing="14px"
                 style="padding:14px; background:#f8fafc;">

            <!-- HEADER (CENTERED) -->
            <hlayout width="100%" style="justify-content:center;">
                <label value="💳 Transaction History"
                       style="font-weight:700;
                              font-size:22px;
                              color:#1e3a8a;"/>
            </hlayout>

            <!-- DATE FILTER + ACTIONS (RESPONSIVE) -->
            <hlayout width="100%"
                     spacing="10px"
                     style="align-items:center;
                            flex-wrap:wrap;
                            row-gap:10px;
                            background:white;
                            padding:12px 14px;
                            border-radius:8px;
                            border:1px solid #e5e7eb;">

                <label value="📅 From:" style="font-weight:600;"/>
                <datebox id="fromDate" width="140px"/>

                <label value="To:" style="font-weight:600;"/>
                <datebox id="toDate" width="140px"/>

                <button id="filterBtn"
                        label="Show Transactions"
                        style="background:#16a34a;
                               color:white;
                               border:none;
                               border-radius:6px;
                               padding:6px 14px;
                               font-weight:600;"/>

                <button id="btnDownloadPdf"
                        label="📄 Download Statement"
                        style="background:#1e293b;
                               color:white;
                               border:none;
                               border-radius:6px;
                               padding:6px 14px;
                               font-weight:600;"/>

                <!-- FLEX SPACER -->
                <div hflex="1"/>

                <!-- REFRESH BUTTON (EXTREME RIGHT) -->
                <button label="⟳"
                        tooltiptext="Refresh"
                        onClick='Executions.sendRedirect(null);'
                        style="background:#2563eb;
                               color:white;
                               border:none;
                               border-radius:50%;
                               width:36px;
                               height:36px;
                               font-size:18px;
                               font-weight:700;
                               padding:0;
                               cursor:pointer;"/>
            </hlayout>

            <!-- TRANSACTION LIST -->
            <listbox id="transactionListbox"
                     vflex="1"
                     hflex="1"
                     mold="paging"
                     pageSize="10"
                     sizedByContent="true"
                     style="border:1px solid #d1d5db;
                            border-radius:8px;
                            background:white;">

                <listhead>
                    <listheader label="Transaction ID" sort="auto"/>
                    <listheader label="From Account" sort="auto"/>
                    <listheader label="To Account" sort="auto"/>
                    <listheader label="Amount" sort="auto"/>
                    <listheader label="Status" sort="auto"/>
                    <listheader label="Date" sort="auto"/>
                    <listheader label="Mode" sort="auto"/>
                    <listheader label="Type" sort="auto"/>
                    <listheader label="Remaining Balance" sort="auto"/>
                </listhead>

            </listbox>

        </vlayout>
    </window>
</zk>
