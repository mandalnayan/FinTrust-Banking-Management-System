<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bank_statement"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <!-- ================= PARAMETERS ================= -->
    <parameter name="bankName" class="java.lang.String"/>
    <parameter name="branchName" class="java.lang.String"/>
    <parameter name="branchAddress" class="java.lang.String"/>
    <parameter name="accountHolderName" class="java.lang.String"/>
    <parameter name="accountNumber" class="java.lang.String"/>
    <parameter name="statementPeriod" class="java.lang.String"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="generatedDate" class="java.time.LocalDateTime"/>
    <parameter name="totalCredits" class="java.math.BigDecimal"/>
    <parameter name="totalDebits" class="java.math.BigDecimal"/>
    <parameter name="closingBalance" class="java.math.BigDecimal"/>

    <!-- ================= FIELDS ================= -->
    <field name="transactionId" class="java.lang.Long"/>
    <field name="txnType" class="java.lang.String"/>
    <field name="mode" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="counterpartyAccountNumber" class="java.lang.Long"/>
    <field name="beneficiaryId" class="java.lang.Long"/>
    <field name="description" class="java.lang.String"/>

    <!-- ================= TITLE ================= -->
    <title>
        <band height="130">
            <textField>
                <reportElement x="0" y="0" width="555" height="25"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{bankName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="25" width="555" height="20"/>
                <textFieldExpression><![CDATA[$P{branchName} + " - " + $P{branchAddress}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="50" width="555" height="20"/>
                <textFieldExpression><![CDATA["Account Holder: " + $P{accountHolderName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textFieldExpression><![CDATA["Account Number: " + $P{accountNumber}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="90" width="555" height="20"/>
                <textFieldExpression><![CDATA["Statement Period: " + $P{statementPeriod}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="110" width="555" height="15"/>
                <textFieldExpression><![CDATA["Generated By: " + $P{generatedBy} + " on " + $P{generatedDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ================= COLUMN HEADER ================= -->
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="50" height="20"/><text><![CDATA[Txn ID]]></text></staticText>
            <staticText><reportElement x="50" y="0" width="50" height="20"/><text><![CDATA[Type]]></text></staticText>
            <staticText><reportElement x="100" y="0" width="50" height="20"/><text><![CDATA[Mode]]></text></staticText>
            <staticText><reportElement x="150" y="0" width="70" height="20"/><text><![CDATA[Amount]]></text></staticText>
            <staticText><reportElement x="220" y="0" width="70" height="20"/><text><![CDATA[Status]]></text></staticText>
            <staticText><reportElement x="290" y="0" width="90" height="20"/><text><![CDATA[Counterparty]]></text></staticText>
            <staticText><reportElement x="380" y="0" width="70" height="20"/><text><![CDATA[Beneficiary]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="105" height="20"/><text><![CDATA[Date & Time]]></text></staticText>
        </band>
    </columnHeader>

    <!-- ================= DETAIL ================= -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{transactionId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{txnType}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{mode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{amount} == null ? java.math.BigDecimal.ZERO : $F{amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="220" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="290" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{counterpartyAccountNumber} == null ? "" : $F{counterpartyAccountNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{beneficiaryId} == null ? "" : $F{beneficiaryId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="450" y="0" width="105" height="20"/>
                <textFieldExpression><![CDATA[$F{createdAt} == null ? "" : $F{createdAt}.toString()]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ================= SUMMARY ================= -->
    <summary>
        <band height="50">
            <textField>
                <reportElement x="400" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA["Total Credits: " + $P{totalCredits}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="20" width="150" height="20"/>
                <textFieldExpression><![CDATA["Total Debits: " + $P{totalDebits}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="40" width="150" height="20"/>
                <textFieldExpression><![CDATA["Closing Balance: " + $P{closingBalance}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
