<?xml version="1.0" encoding="UTF-8"?>
<!-- Compatible with JasperReports 6.x -->
<jasperReport name="newAirtelReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
              
     <!-- ================= Style ============= -->
     <style name="BankTitleStyle"
       fontName="Helvetica"
       fontSize="15"
       isBold="true"
       hAlign="Left"
       vAlign="Middle"/>
     
     <style name="HeaderTitle" fontSize="15" isBold="true"/>
<style name="ColumnHeader"
       fontSize="12"
       isBold="true"
       hAlign="Center"
       vAlign="Middle"/>

<style name="DetailText"
       fontSize="10"
       hAlign="Center"
       vAlign="Middle"/>
     

     

    <!-- ================= PARAMETERS ================= -->
    <parameter name="name" class="java.lang.String"/>
    <parameter name="address" class="java.lang.String"/>
    <parameter name="duration" class="java.lang.String"/>
    <parameter name="accountNo" class="java.lang.Long"/>

    <parameter name="column1" class="java.lang.String"/>
    <parameter name="column2" class="java.lang.String"/>
    <parameter name="column3" class="java.lang.String"/>
    <parameter name="column4" class="java.lang.String"/>
    <parameter name="column5" class="java.lang.String"/>
    
     <parameter name="totalBalance" class="java.lang.Double"/>

    <!-- ================= FIELDS (Mapped to Transaction model) ================= -->
    <field name="transactionId" class="java.lang.Long"/>
    <field name="accountNumber" class="java.lang.Long"/>
    <field name="counterpartyAccountNumber" class="java.lang.Long"/>
    <field name="txnType" class="java.lang.String"/>
    <field name="balanceAfter" class="java.math.BigDecimal"/>

    <!-- ================= TITLE ================= -->
    <title>
    <band height="82">

        <!-- BANK LOGO -->
        <image>
            <reportElement x="0" y="0" width="140" height="60"/>
            <imageExpression><![CDATA["/home/iispl/Pictures/Screenshots/bank-logo.png"]]></imageExpression>
        </image>

        <!-- BANK NAME -->
        <staticText>
            <reportElement x="155" y="0" width="250" height="30" />
            <!-- Inline Css -->
             <textElement textAlignment="Left" verticalAlignment="Middle">
        <font size="18" isBold="true"/>
    </textElement>
            <text><![CDATA[FinTrust Bank of Wiki]]></text>
        </staticText>

        <!-- BANK ADDRESS -->
        <staticText>
            <reportElement x="155" y="15" width="220" height="40"/>
            <text><![CDATA[
1425 JAMES ST, PO BOX 4000 VICTORIA BC V8X 3X4
1-800-555-5555]]></text>
        </staticText>

        <!-- REPORT TITLE -->
        <staticText>
            <reportElement x="380" y="0" width="175" height="40"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
        <font size="12" isBold="true"/>
    </textElement>
            <text><![CDATA[Bank Transaction Statement]]></text>
        </staticText>

    </band>
</title>

    <!-- ================= PAGE HEADER ================= -->
   <pageHeader>
    <band height="75">

        <textField>
            <reportElement x="0" y="25" width="100" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[$P{name}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement x="0" y="40" width="100" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[$P{address}]]></textFieldExpression>
        </textField>

        <staticText>
            <reportElement x="280" y="25" width="155" height="20" style = "ColumnHeader"/>
            <text><![CDATA[Statement period]]></text>
        </staticText>
        <textField>
            <reportElement x="280" y="40" width="153" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[$P{duration}]]></textFieldExpression>
        </textField>
 <staticText>
            <reportElement x="440" y="25" width="115" height="20" style = "ColumnHeader"/>
            <text><![CDATA[Account No.]]></text>
        </staticText>
        <textField>
            <reportElement x="439" y="40" width="116" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[$P{accountNo}]]></textFieldExpression>
        </textField>

 <!-- PAGE NUMBER -->
        <textField>
            <reportElement x="460" y="0" width="100" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
        </textField>

        <textField evaluationTime="Report">
            <reportElement x="505" y="0" width="75" height="20" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
        </textField>


    </band>
</pageHeader>


    <!-- ================= COLUMN HEADER ================= -->
   <columnHeader >
    <band height="55">

        <!-- Background -->
        <rectangle>
             <reportElement
        x="0"
        y="0"
        width="555"
        height="50"
        backcolor="#2F5597"
        mode="Opaque"/>
        </rectangle>

        <!-- Column 1 -->
        <textField >
            <reportElement x="0" y="15" width="100" height="30" style = "ColumnHeader" mode="Transparent"/>
              <textFieldExpression><![CDATA[$P{column1}]]></textFieldExpression>
        </textField>

        <!-- Column 2 -->
        <textField  >
            <reportElement x="113" y="15" width="100" height="30" style = "ColumnHeader"/>
             <textFieldExpression><![CDATA[$P{column2}]]></textFieldExpression>
        </textField>

        <!-- Column 3 -->
        <textField >
            <reportElement x="220" y="15" width="100" height="30" style = "ColumnHeader"/>
              <textFieldExpression><![CDATA[$P{column3}]]></textFieldExpression>
        </textField>

        <!-- Column 4 -->
        <textField>
            <reportElement x="333" y="15" width="100" height="30" style = "ColumnHeader"/>
            <textFieldExpression><![CDATA[$P{column4}]]></textFieldExpression>
        </textField>

        <!-- Column 5 -->
       <textField>
            <reportElement x="447" y="15" width="100" height="30" style = "ColumnHeader"/>
           <textFieldExpression><![CDATA[$P{column5}]]></textFieldExpression>
        </textField>

    </band>
</columnHeader>


    <!-- ================= DETAIL ================= -->
   <detail>
    <band height="30">

        <textField>
            <reportElement x="0" y="5" width="100" height="20" style = "DetailText"/>
            <textFieldExpression><![CDATA[$F{transactionId}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement x="113" y="5" width="100" height="20" style = "DetailText"/>
            <textFieldExpression><![CDATA[$F{accountNumber}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement x="220" y="5" width="100" height="20" style = "DetailText"/>
            <textFieldExpression><![CDATA[$F{counterpartyAccountNumber}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement x="333" y="5" width="100" height="20" style = "DetailText"/>
            <textFieldExpression><![CDATA[$F{txnType}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement x="447" y="5" width="100" height="20" style = "DetailText"/>
            <textFieldExpression><![CDATA[$F{balanceAfter}]]></textFieldExpression>
        </textField>

    </band>
</detail>
   

    <columnFooter/>
    <pageFooter/>
    <summary>
    <band height="60">
      <!-- Background -->
        <rectangle>
             <reportElement
        x="0"
        y="0"
        width="555"
        height="30"
        
        backcolor="#2F5597"
        mode="Opaque"/>
        </rectangle>
    
    
    <staticText>
            <reportElement x="340" y="10" width="200" height="30" style = "HeaderTitle"/>
            <text><![CDATA[Available balance: ]]></text>
        </staticText>
    
      <textField >
            <reportElement x="470" y="10" width="100" height="30" style = "HeaderTitle"
            />
              <textFieldExpression><![CDATA[$P{totalBalance}]]></textFieldExpression>
        </textField>
        
        <staticText>
            <reportElement x="120" y="40" width="450" height="20" style = "HeaderTitle"/>
            <text><![CDATA[Thank You!! We are glad to provide you service! ]]></text>
        </staticText>

    </band>

     </summary>

</jasperReport>
